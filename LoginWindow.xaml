<Window x:Class="Hotel_Management.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Title="Đăng nhập - Kinkaku-ji Onsen" Height="650" Width="1000"
        WindowStartupLocation="CenterScreen" WindowStyle="None"
        Background="Transparent" AllowsTransparency="True"
        ResizeMode="NoResize"
        FontFamily="Segoe UI"
        Icon="/Assets/icon.ico"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Border CornerRadius="8" Background="{DynamicResource PrimaryBackgroundColor}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="450"/>
            </Grid.ColumnDefinitions>

            <!-- Left Side: Branding / Background -->
            <Border Grid.Column="0" CornerRadius="8,0,0,8" Background="{DynamicResource SecondaryBackgroundColor}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Image Source="/Assets/logo.png" Width="180" Height="180" Margin="0,0,0,16"/>
                    <TextBlock Text="KINKAKU-JI ONSEN" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource PrimaryBlueColor}" HorizontalAlignment="Center"/>
                    <TextBlock Text="Hệ thống quản lý khách sạn suối nước nóng" FontSize="13.5" Foreground="{DynamicResource PrimaryGrayColor}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

            <!-- Right Side: Login Form -->
            <Grid Grid.Column="1">
                <!-- Window Controls -->
                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Orientation="Horizontal" FlowDirection="RightToLeft" Margin="0,10,12,0" Height="30">
                    <Button Style="{DynamicResource IconButtonsStyle}" Content="{DynamicResource close}" Tag="IsCloseButton" Click="btnClose_Click" ToolTip="Đóng ứng dụng"/>
                    <Button Style="{DynamicResource IconButtonsStyle}" Content="{DynamicResource minimize}" Margin="5,0" Click="btnMinimize_Click" ToolTip="Thu nhỏ cửa sổ"/>
                    <Button Margin="5,0" Click="btnThemeToggle_Click" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextSecondaryColor}" Cursor="Hand" ToolTip="Đổi giao diện Sáng / Tối">
                        <iconPacks:PackIconBootstrapIcons x:Name="iconTheme" Kind="MoonFill"/>
                    </Button>
                </StackPanel>

                <StackPanel VerticalAlignment="Center" Margin="50,0,50,0">
                    <TextBlock Text="Đăng nhập" FontSize="26" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryColor}" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                    <TextBlock Text="Vui lòng nhập tài khoản để vào hệ thống" FontSize="13.5" Foreground="{DynamicResource PrimaryGrayColor}" HorizontalAlignment="Center" Margin="0,0,0,28"/>

                    <!-- Username -->
                    <TextBlock Text="Tên đăng nhập" Foreground="{DynamicResource TextSecondaryColor}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <Border CornerRadius="6" Background="{DynamicResource SecondaryBackgroundColor}" BorderBrush="{DynamicResource SecondaryGrayColor}" BorderThickness="1" Height="42" Margin="0,0,0,18">
                        <Grid>
                            <iconPacks:PackIconBootstrapIcons Kind="PersonFill" Foreground="{DynamicResource PrimaryGrayColor}" VerticalAlignment="Center" Margin="14,0,0,0"/>
                            <TextBox x:Name="txtUsername" Width="Auto" Height="Auto" Background="Transparent" BorderThickness="0" Padding="0" Margin="42,0,12,0" FontSize="14.5" Style="{DynamicResource TextBoxStyle}" Tag="Nhập tên đăng nhập..."/>
                        </Grid>
                    </Border>

                    <!-- Password -->
                    <TextBlock Text="Mật khẩu" Foreground="{DynamicResource TextSecondaryColor}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <Border CornerRadius="6" Background="{DynamicResource SecondaryBackgroundColor}" BorderBrush="{DynamicResource SecondaryGrayColor}" BorderThickness="1" Height="42" Margin="0,0,0,24">
                        <Grid>
                            <iconPacks:PackIconBootstrapIcons Kind="LockFill" Foreground="{DynamicResource PrimaryGrayColor}" VerticalAlignment="Center" Margin="14,0,0,0"/>
                            <PasswordBox x:Name="txtPassword" Width="Auto" Height="Auto" Background="Transparent" BorderThickness="0" Padding="0" Margin="42,0,42,0" FontSize="14.5" Style="{DynamicResource PasswordBoxStyle}"/>
                            <TextBox x:Name="txtPasswordVisible" Width="Auto" Height="Auto" Background="Transparent" BorderThickness="0" Padding="0" Margin="42,0,42,0" FontSize="14.5" Style="{DynamicResource TextBoxStyle}" Tag="Nhập mật khẩu..." Visibility="Collapsed"/>
                            <Button x:Name="btnTogglePassword" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" Width="28" Height="28" Cursor="Hand" Focusable="False" Click="btnTogglePassword_Click" ToolTip="Hiện / Ẩn mật khẩu">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="Transparent">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                                <iconPacks:PackIconBootstrapIcons x:Name="iconEye" Kind="EyeSlashFill" Width="17" Height="17" Foreground="{DynamicResource PrimaryGrayColor}"/>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Error Message -->
                    <TextBlock x:Name="txtError" Foreground="{DynamicResource ErrorNotification}" FontSize="13" HorizontalAlignment="Center" Margin="0,0,0,14" Visibility="Collapsed" TextWrapping="Wrap" TextAlignment="Center"/>

                    <!-- Login Button -->
                    <Button x:Name="btnLogin" Content="Đăng nhập" Height="42" Style="{DynamicResource PrimaryButtonStyle}" IsDefault="True" Click="btnLogin_Click" FontSize="15" FontWeight="SemiBold"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
