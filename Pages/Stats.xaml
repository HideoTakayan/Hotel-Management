<Page x:Class="Hotel_Management.Pages.Stats"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Hotel_Management.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="566" d:DesignWidth="920" Title="Thống Kê &amp; Báo Cáo" FontFamily="Times New Roman">

    <Border CornerRadius="5" Background="{DynamicResource SecondaryBackgroundColor}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="65"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Label Grid.Row="0" Content="Thống Kê &amp; Báo Cáo" 
                   Style="{DynamicResource LabelStyle}" 
                   HorizontalAlignment="Left" VerticalAlignment="Center" 
                   Margin="40 0 0 0" Padding="10 5 0 5"
                   BorderBrush="{DynamicResource PrimaryBlueColor}" BorderThickness="4 0 0 0"/>

            <Border Grid.Row="1" CornerRadius="5" Background="{DynamicResource PrimaryBackgroundColor}" Margin="20,0,20,10">
                <StackPanel Orientation="Horizontal" Margin="20,10,0,10">
                    <TextBlock Text="Chọn tháng" Width="100" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryColor}" FontSize="15"/>
                    <DatePicker x:Name="dateThoiGian" Width="200" Style="{DynamicResource DatePickerStyle}" SelectedDateChanged="DateThoiGian_SelectedDateChanged" />
                    <Button x:Name="btnRefresh" Content="Xem Thống Kê" Margin="20,0,0,0" Width="130" Style="{DynamicResource PrimaryButtonStyle}" Click="btnRefresh_Click"/>
                </StackPanel>
            </Border>

            <Grid Grid.Row="2" Margin="20,5,20,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <!-- Thẻ 1: Lượt đặt phòng -->
                <Border Grid.Column="0" CornerRadius="6" Background="{DynamicResource PrimaryBackgroundColor}" BorderBrush="{DynamicResource PrimaryBlueColor}" BorderThickness="1" Margin="0,0,8,0" Padding="12,12">
                    <StackPanel Orientation="Vertical">
                        <TextBlock Foreground="{DynamicResource TextSecondaryColor}" FontSize="13" FontWeight="Bold" Text="Lượt Đặt Phòng"/>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <iconPacks:PackIconBootstrapIcons Width="28" Height="28" Kind="Buildings" Foreground="{DynamicResource PrimaryBlueColor}" VerticalAlignment="Center"/>
                            <StackPanel Margin="10,0,0,0">
                                <TextBlock x:Name="txtSoLan" Foreground="{DynamicResource TextSecondaryColor}" FontSize="16" FontWeight="Bold" Text="0 lượt"/>
                                <TextBlock Text="Đã thanh toán" FontSize="11" Foreground="{DynamicResource PrimaryGrayColor}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>
                
                <!-- Thẻ 2: Doanh thu phòng -->
                <Border Grid.Column="1" CornerRadius="6" Background="{DynamicResource PrimaryBackgroundColor}" BorderBrush="{DynamicResource PrimaryBlueColor}" BorderThickness="1" Margin="4,0,4,0" Padding="12,12">
                    <StackPanel Orientation="Vertical">
                        <TextBlock Foreground="{DynamicResource TextSecondaryColor}" FontSize="13" FontWeight="Bold" Text="Tiền Phòng"/>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <iconPacks:PackIconBootstrapIcons Width="28" Height="28" Kind="DoorOpenFill" Foreground="{DynamicResource PrimaryBlueColor}" VerticalAlignment="Center"/>
                            <StackPanel Margin="10,0,0,0">
                                <TextBlock x:Name="txtTienPhong" Foreground="{DynamicResource TextSecondaryColor}" FontSize="16" FontWeight="Bold" Text="0 VND"/>
                                <TextBlock Text="Thu từ phòng" FontSize="11" Foreground="{DynamicResource PrimaryGrayColor}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Thẻ 3: Doanh thu dịch vụ -->
                <Border Grid.Column="2" CornerRadius="6" Background="{DynamicResource PrimaryBackgroundColor}" BorderBrush="{DynamicResource PrimaryBlueColor}" BorderThickness="1" Margin="4,0,4,0" Padding="12,12">
                    <StackPanel Orientation="Vertical">
                        <TextBlock Foreground="{DynamicResource TextSecondaryColor}" FontSize="13" FontWeight="Bold" Text="Tiền Dịch Vụ"/>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <iconPacks:PackIconBootstrapIcons Width="28" Height="28" Kind="CupHotFill" Foreground="{DynamicResource PrimaryBlueColor}" VerticalAlignment="Center"/>
                            <StackPanel Margin="10,0,0,0">
                                <TextBlock x:Name="txtTienDichVu" Foreground="{DynamicResource TextSecondaryColor}" FontSize="16" FontWeight="Bold" Text="0 VND"/>
                                <TextBlock Text="Dịch vụ phát sinh" FontSize="11" Foreground="{DynamicResource PrimaryGrayColor}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Thẻ 4: Tổng doanh thu -->
                <Border Grid.Column="3" CornerRadius="6" Background="{DynamicResource PrimaryBackgroundColor}" BorderBrush="{DynamicResource PrimaryBlueColor}" BorderThickness="1" Margin="8,0,0,0" Padding="12,12">
                    <StackPanel Orientation="Vertical">
                        <TextBlock Foreground="{DynamicResource TextSecondaryColor}" FontSize="13" FontWeight="Bold" Text="Tổng Doanh Thu"/>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <iconPacks:PackIconBootstrapIcons Width="28" Height="28" Kind="CashCoin" Foreground="{DynamicResource SuccessNotification}" VerticalAlignment="Center"/>
                            <StackPanel Margin="10,0,0,0">
                                <TextBlock x:Name="txtLoiNhuan" Foreground="{DynamicResource SuccessNotification}" FontSize="16" FontWeight="Bold" Text="0 VND"/>
                                <TextBlock Text="Toàn bộ tháng" FontSize="11" Foreground="{DynamicResource PrimaryGrayColor}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Row 3: Chi tiết Top dịch vụ và Tình trạng phòng -->
            <Grid Grid.Row="3" Margin="20,0,20,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="6*"/>
                    <ColumnDefinition Width="4*"/>
                </Grid.ColumnDefinitions>

                <!-- Cột trái: Top dịch vụ bán chạy -->
                <Border Grid.Column="0" CornerRadius="6" Background="{DynamicResource PrimaryBackgroundColor}" BorderBrush="{DynamicResource PrimaryBlueColor}" BorderThickness="1" Margin="0,0,10,0">
                    <Grid Margin="15">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Top Dịch Vụ Đem Lại Doanh Thu Cao Nhất" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource PrimaryBlueColor}" Margin="0,0,0,10"/>
                        <DataGrid Grid.Row="1" x:Name="dgTopServices" AutoGenerateColumns="False" IsReadOnly="True" Style="{DynamicResource DataGridStyle}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Tên Dịch Vụ" Binding="{Binding ServiceName}" Width="1.8*"/>
                                <DataGridTextColumn Header="ĐVT" Binding="{Binding Unit}" Width="0.7*"/>
                                <DataGridTextColumn Header="Số Lượng" Binding="{Binding Quantity}" Width="0.7*"/>
                                <DataGridTextColumn Header="Doanh Thu (VND)" Binding="{Binding TotalRevenue, StringFormat={}{0:N0}}" Width="1.2*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <!-- Cột phải: Tình trạng phòng hiện tại -->
                <Border Grid.Column="1" CornerRadius="6" Background="{DynamicResource PrimaryBackgroundColor}" BorderBrush="{DynamicResource PrimaryBlueColor}" BorderThickness="1" Margin="10,0,0,0">
                    <StackPanel Margin="18" VerticalAlignment="Top">
                        <TextBlock Text="Tình Trạng Phòng Hiện Tại" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource PrimaryBlueColor}" Margin="0,0,0,18"/>
                        
                        <Grid Margin="0,0,0,14">
                            <TextBlock Text="🟢 Phòng sẵn sàng (Trống):" FontSize="14" Foreground="{DynamicResource TextSecondaryColor}"/>
                            <TextBlock x:Name="txtPhongTrong" Text="0 phòng" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource SuccessNotification}" HorizontalAlignment="Right"/>
                        </Grid>
                        
                        <Grid Margin="0,0,0,14">
                            <TextBlock Text="🔵 Phòng đang sử dụng:" FontSize="14" Foreground="{DynamicResource TextSecondaryColor}"/>
                            <TextBlock x:Name="txtPhongDangDung" Text="0 phòng" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource PrimaryBlueColor}" HorizontalAlignment="Right"/>
                        </Grid>

                        <Grid Margin="0,0,0,14">
                            <TextBlock Text="🟡 Phòng đã đặt trước:" FontSize="14" Foreground="{DynamicResource TextSecondaryColor}"/>
                            <TextBlock x:Name="txtPhongDaDat" Text="0 phòng" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource WarningNotification}" HorizontalAlignment="Right"/>
                        </Grid>

                        <Grid Margin="0,0,0,5">
                            <TextBlock Text="🔴 Phòng chờ / đang dọn:" FontSize="14" Foreground="{DynamicResource TextSecondaryColor}"/>
                            <TextBlock x:Name="txtPhongDonDep" Text="0 phòng" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource ErrorNotification}" HorizontalAlignment="Right"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Page>
