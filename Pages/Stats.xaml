<Page x:Class="Hotel_Management.Pages.Stats"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Hotel_Management.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="566" d:DesignWidth="920" Title="Thống kê và báo cáo" FontFamily="Segoe UI">

    <Border CornerRadius="5" Background="{DynamicResource SecondaryBackgroundColor}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="65"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Label Grid.Row="0" Content="Thống kê và báo cáo" 
                   Style="{DynamicResource LabelStyle}" 
                   HorizontalAlignment="Left" VerticalAlignment="Center" 
                   Margin="40 0 0 0" Padding="10 5 0 5"
                   BorderBrush="{DynamicResource PrimaryBlueColor}" BorderThickness="4 0 0 0"/>

            <Border Grid.Row="1" CornerRadius="5" Background="{DynamicResource PrimaryBackgroundColor}" BorderBrush="{DynamicResource SecondaryGrayColor}" BorderThickness="1" Margin="20,0,20,10">
                <StackPanel Orientation="Horizontal" Margin="20,10,0,10">
                    <TextBlock Text="Tháng" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryColor}" FontSize="15" Margin="0,0,12,0"/>
                    <ComboBox x:Name="cbMonth" Width="120" Style="{DynamicResource ComboBoxStyle}" SelectionChanged="Filter_SelectionChanged"/>
                    
                    <TextBlock Text="Năm" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryColor}" FontSize="15" Margin="20,0,12,0"/>
                    <ComboBox x:Name="cbYear" Width="100" Style="{DynamicResource ComboBoxStyle}" SelectionChanged="Filter_SelectionChanged"/>
                    
                    <Button x:Name="btnRefresh" Content="Xem thống kê" Margin="20,0,0,0" Width="130" Style="{DynamicResource PrimaryButtonStyle}" Click="btnRefresh_Click"/>
                </StackPanel>
            </Border>

            <Grid Grid.Row="2" Margin="20,5,20,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <Border Grid.Column="0" CornerRadius="6" Background="{DynamicResource PrimaryBackgroundColor}" BorderBrush="{DynamicResource SecondaryGrayColor}" BorderThickness="1" Margin="0,0,8,0" Padding="12,12">
                    <StackPanel Orientation="Vertical">
                        <TextBlock Foreground="{DynamicResource TextSecondaryColor}" FontSize="13" FontWeight="Bold" Text="Lượt đặt phòng"/>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <iconPacks:PackIconBootstrapIcons Width="24" Height="24" Kind="Buildings" Foreground="{DynamicResource PrimaryBlueColor}" VerticalAlignment="Center"/>
                            <StackPanel Margin="8,0,0,0">
                                <TextBlock x:Name="txtSoLan" Foreground="{DynamicResource TextSecondaryColor}" FontSize="15" FontWeight="Bold" Text="0 lượt"/>
                                <TextBlock Text="Hoàn tất lưu trú" FontSize="11" Foreground="{DynamicResource PrimaryGrayColor}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>
                
                <Border Grid.Column="1" CornerRadius="6" Background="{DynamicResource PrimaryBackgroundColor}" BorderBrush="{DynamicResource SecondaryGrayColor}" BorderThickness="1" Margin="4,0,4,0" Padding="12,12">
                    <StackPanel Orientation="Vertical">
                        <TextBlock Foreground="{DynamicResource TextSecondaryColor}" FontSize="13" FontWeight="Bold" Text="Tiền phòng"/>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <iconPacks:PackIconBootstrapIcons Width="24" Height="24" Kind="DoorOpenFill" Foreground="{DynamicResource PrimaryBlueColor}" VerticalAlignment="Center"/>
                            <StackPanel Margin="8,0,0,0">
                                <TextBlock x:Name="txtTienPhong" Foreground="{DynamicResource TextSecondaryColor}" FontSize="15" FontWeight="Bold" Text="0 VND"/>
                                <TextBlock Text="Thu từ phòng" FontSize="11" Foreground="{DynamicResource PrimaryGrayColor}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" CornerRadius="6" Background="{DynamicResource PrimaryBackgroundColor}" BorderBrush="{DynamicResource SecondaryGrayColor}" BorderThickness="1" Margin="4,0,4,0" Padding="12,12">
                    <StackPanel Orientation="Vertical">
                        <TextBlock Foreground="{DynamicResource TextSecondaryColor}" FontSize="13" FontWeight="Bold" Text="Tiền dịch vụ"/>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <iconPacks:PackIconBootstrapIcons Width="24" Height="24" Kind="CupHotFill" Foreground="{DynamicResource PrimaryBlueColor}" VerticalAlignment="Center"/>
                            <StackPanel Margin="8,0,0,0">
                                <TextBlock x:Name="txtTienDichVu" Foreground="{DynamicResource TextSecondaryColor}" FontSize="15" FontWeight="Bold" Text="0 VND"/>
                                <TextBlock Text="Dịch vụ phát sinh" FontSize="11" Foreground="{DynamicResource PrimaryGrayColor}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Column="3" CornerRadius="6" Background="{DynamicResource PrimaryBackgroundColor}" BorderBrush="{DynamicResource SecondaryGrayColor}" BorderThickness="1" Margin="8,0,0,0" Padding="12,12">
                    <StackPanel Orientation="Vertical">
                        <TextBlock Foreground="{DynamicResource TextSecondaryColor}" FontSize="13" FontWeight="Bold" Text="Tổng doanh thu"/>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <iconPacks:PackIconBootstrapIcons Width="24" Height="24" Kind="CashCoin" Foreground="{DynamicResource SuccessNotification}" VerticalAlignment="Center"/>
                            <StackPanel Margin="8,0,0,0">
                                <TextBlock x:Name="txtLoiNhuan" Foreground="{DynamicResource SuccessNotification}" FontSize="15" FontWeight="Bold" Text="0 VND"/>
                                <TextBlock Text="Toàn bộ tháng" FontSize="11" Foreground="{DynamicResource PrimaryGrayColor}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Grid.Row="3" Margin="20,0,20,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="6*"/>
                    <ColumnDefinition Width="4*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" CornerRadius="6" Background="{DynamicResource PrimaryBackgroundColor}" BorderBrush="{DynamicResource SecondaryGrayColor}" BorderThickness="1" Margin="0,0,10,0">
                    <Grid Margin="15">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Dịch vụ có doanh thu cao nhất" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryColor}" Margin="0,0,0,10"/>
                        <DataGrid Grid.Row="1" x:Name="dgTopServices" AutoGenerateColumns="False" IsReadOnly="True" Style="{DynamicResource DataGridStyle}" HorizontalScrollBarVisibility="Disabled">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Tên dịch vụ" Binding="{Binding ServiceName}" Width="*"/>
                                <DataGridTextColumn Header="ĐVT" Binding="{Binding Unit}" Width="75"/>
                                <DataGridTextColumn Header="Số lượng" Binding="{Binding Quantity}" Width="75"/>
                                <DataGridTextColumn Header="Doanh thu (VND)" Binding="{Binding TotalRevenue, StringFormat={}{0:N0}}" Width="135"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <Border Grid.Column="1" CornerRadius="6" Background="{DynamicResource PrimaryBackgroundColor}" BorderBrush="{DynamicResource SecondaryGrayColor}" BorderThickness="1" Margin="10,0,0,0">
                    <StackPanel Margin="18" VerticalAlignment="Top">
                        <TextBlock Text="Tình trạng phòng hiện tại" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryColor}" Margin="0,0,0,18"/>
                        
                        <Grid Margin="0,0,0,14">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="8" Height="8" Fill="{DynamicResource SuccessNotification}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Phòng sẵn sàng (Trống):" FontSize="13.5" Foreground="{DynamicResource TextSecondaryColor}"/>
                            </StackPanel>
                            <TextBlock x:Name="txtPhongTrong" Text="0 phòng" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource SuccessNotification}" HorizontalAlignment="Right"/>
                        </Grid>
                        
                        <Grid Margin="0,0,0,14">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="8" Height="8" Fill="{DynamicResource PrimaryBlueColor}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Phòng đang sử dụng:" FontSize="13.5" Foreground="{DynamicResource TextSecondaryColor}"/>
                            </StackPanel>
                            <TextBlock x:Name="txtPhongDangDung" Text="0 phòng" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource PrimaryBlueColor}" HorizontalAlignment="Right"/>
                        </Grid>

                        <Grid Margin="0,0,0,14">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="8" Height="8" Fill="{DynamicResource WarningNotification}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Phòng đã đặt trước:" FontSize="13.5" Foreground="{DynamicResource TextSecondaryColor}"/>
                            </StackPanel>
                            <TextBlock x:Name="txtPhongDaDat" Text="0 phòng" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource WarningNotification}" HorizontalAlignment="Right"/>
                        </Grid>

                        <Grid Margin="0,0,0,5">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="8" Height="8" Fill="{DynamicResource ErrorNotification}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Phòng chờ / đang dọn:" FontSize="13.5" Foreground="{DynamicResource TextSecondaryColor}"/>
                            </StackPanel>
                            <TextBlock x:Name="txtPhongDonDep" Text="0 phòng" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource ErrorNotification}" HorizontalAlignment="Right"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Page>
