<Page x:Class="Hotel_Management.Pages.BillDetails"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      mc:Ignorable="d" 
      d:DesignHeight="566" d:DesignWidth="920" Title="Chi Tiết Hóa Đơn Dịch Vụ" FontFamily="Times New Roman">

    <Border CornerRadius="5" Background="{DynamicResource SecondaryBackgroundColor}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="65"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Label Grid.Row="0" Content="Chi Tiết Hóa Đơn Dịch Vụ" 
                   Style="{DynamicResource LabelStyle}" 
                   HorizontalAlignment="Left" VerticalAlignment="Center" 
                   Margin="40 0 0 0" Padding="10 5 0 5"
                   BorderBrush="{DynamicResource PrimaryBlueColor}" BorderThickness="4 0 0 0"/>

            <Button Grid.Row="0" Content="Quay Lại" Width="110" HorizontalAlignment="Right" Margin="0,0,20,0"
                    Style="{DynamicResource SecondaryButtonStyle}" Click="BtnBack_Click"/>

            <!-- Khung Thông tin Phòng & Khách hàng -->
            <Border Grid.Row="1" Margin="20,4,20,12" Padding="20,12" Background="{DynamicResource PrimaryBackgroundColor}" CornerRadius="6" BorderBrush="{DynamicResource PrimaryBlueColor}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" x:Name="txtPhong" Text="Phòng: ..." FontSize="16" FontWeight="Bold" Foreground="{DynamicResource PrimaryBlueColor}"/>
                    <TextBlock Grid.Column="1" x:Name="txtKhachHang" Text="Khách hàng: ..." FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryColor}"/>
                </Grid>
            </Border>

            <!-- DataGrid -->
            <DataGrid x:Name="dgServices" Grid.Row="2" Margin="20,0,20,12" AutoGenerateColumns="False" IsReadOnly="True" Style="{DynamicResource DataGridStyle}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Tên dịch vụ" Binding="{Binding ServiceName}" Width="1.8*"/>
                    <DataGridTextColumn Header="Đơn giá (VND)" Binding="{Binding Price, StringFormat={}{0:N0}}" Width="*"/>
                    <DataGridTextColumn Header="Số lượng" Binding="{Binding Quantity}" Width="0.7*"/>
                    <DataGridTextColumn Header="Thành tiền (VND)" Binding="{Binding Total, StringFormat={}{0:N0}}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Khung Tổng kết chi phí -->
            <Border Grid.Row="3" Margin="20,0,20,20" Padding="20,14" Background="{DynamicResource PrimaryBackgroundColor}" CornerRadius="6" BorderBrush="{DynamicResource PrimaryBlueColor}" BorderThickness="1" HorizontalAlignment="Right" MinWidth="380">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <TextBlock Text="Tiền phòng:" FontSize="15" Foreground="{DynamicResource TextSecondaryColor}" HorizontalAlignment="Left"/>
                        <TextBlock x:Name="txtTienPhong" Text="0 VND" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryColor}" HorizontalAlignment="Right"/>
                    </Grid>
                    <Grid Margin="0,0,0,10">
                        <TextBlock Text="Tiền dịch vụ phát sinh:" FontSize="15" Foreground="{DynamicResource TextSecondaryColor}" HorizontalAlignment="Left"/>
                        <TextBlock x:Name="txtTienDichVu" Text="0 VND" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryColor}" HorizontalAlignment="Right"/>
                    </Grid>
                    <Rectangle Height="1" Fill="{DynamicResource PrimaryGrayColor}" Opacity="0.4" Margin="0,0,0,10"/>
                    <Grid>
                        <TextBlock Text="TỔNG CỘNG:" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource PrimaryBlueColor}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        <TextBlock x:Name="txtTongCong" Text="0 VND" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource ErrorNotification}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Page>
