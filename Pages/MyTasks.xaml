<Page x:Class="Hotel_Management.Pages.MyTasks"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
      d:DesignHeight="566" d:DesignWidth="920" Title="Nhiệm Vụ Của Tôi" FontFamily="Segoe UI">

    <Page.Resources>
        <!-- Nút hành động chính trong DataGrid (Duyệt / Nhận việc / Báo cáo) -->
        <Style x:Key="TaskActionPrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{Binding PrimaryActionBgColor}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Nút Làm lại (Amber Warning Outline) -->
        <Style x:Key="TaskActionRejectButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#F59E0B"/>
            <Setter Property="BorderBrush" Value="#F59E0B"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Padding" Value="9,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#26F59E0B"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#40F59E0B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Nút Hủy (Red Danger Outline) -->
        <Style x:Key="TaskActionDeleteButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#EF4444"/>
            <Setter Property="BorderBrush" Value="#EF4444"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Padding" Value="9,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#26EF4444"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#40EF4444"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Border CornerRadius="5" Background="{DynamicResource SecondaryBackgroundColor}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="70"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Label Grid.Row="0" x:Name="lblTitle" Content="Nhiệm vụ của tôi" 
                Style="{DynamicResource LabelStyle}" 
                HorizontalAlignment="Left" VerticalAlignment="Center" 
                Margin="40 0 0 0" Padding="10 5 0 5"
                BorderBrush="{DynamicResource PrimaryBlueColor}" BorderThickness="4 0 0 0"/>    

            <Button Grid.Row="0" x:Name="btnRefresh" Content="Làm mới" Width="120" Height="36"
                    HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,20,0"
                    Style="{DynamicResource SecondaryButtonStyle}" Click="btnRefresh_Click"/>

            <!-- Form Giao Việc Mới cho Quản lý (Ẩn đối với Nhân viên) -->
            <Border Grid.Row="1" x:Name="AdminAssignPanel" Background="{DynamicResource PrimaryBackgroundColor}" CornerRadius="5" BorderBrush="{DynamicResource SecondaryGrayColor}" BorderThickness="1" Padding="15,12" Margin="20,0,20,12" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="Giao việc mới" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource TextPrimaryColor}" Margin="0,0,0,10"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,12,0" VerticalAlignment="Center">
                            <TextBlock Text="Phòng" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryColor}" FontSize="14" Margin="0,0,6,0"/>
                            <ComboBox x:Name="cbTaskRoom" Width="115" Height="36" Style="{DynamicResource ComboBoxStyle}" DisplayMemberPath="RoomNumber" SelectedValuePath="RoomId"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,12,0" VerticalAlignment="Center">
                            <TextBlock Text="Giao cho" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryColor}" FontSize="14" Margin="0,0,6,0"/>
                            <ComboBox x:Name="cbTaskStaff" Width="175" Height="36" Style="{DynamicResource ComboBoxStyle}" DisplayMemberPath="FullName" SelectedValuePath="Id"/>
                        </StackPanel>

                        <Grid Grid.Column="2" Margin="0,0,12,0" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Nhiệm vụ" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryColor}" FontSize="14" Margin="0,0,6,0"/>
                            <TextBox Grid.Column="1" x:Name="txtTaskName" Width="Auto" Height="36" Style="{DynamicResource TextBoxStyle}" Tag="Nhập tên công việc cần giao..."/>
                        </Grid>

                        <Button Grid.Column="3" x:Name="btnCreateTask" Content="Giao việc" Width="105" Height="36" Style="{DynamicResource PrimaryButtonStyle}" Click="btnCreateTask_Click"/>
                    </Grid>
                </StackPanel>
            </Border>
            
            <DataGrid Grid.Row="2" x:Name="dgTasks" Margin="20,0,20,20" Style="{DynamicResource DataGridStyle}" RowHeight="42" HorizontalScrollBarVisibility="Disabled">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Ngày làm" Binding="{Binding WorkDate, StringFormat=dd/MM/yyyy}" Width="84"/>
                    <DataGridTextColumn Header="Ca trực" Binding="{Binding ShiftName}" Width="66"/>
                    <DataGridTextColumn Header="Phòng" Binding="{Binding RoomNumber}" Width="56"/>
                    <DataGridTemplateColumn Header="Nhiệm vụ" Width="*" MinWidth="150">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding TaskName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding TaskName}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Phụ trách" Binding="{Binding AssigneeName}" Width="125"/>
                    <DataGridTemplateColumn Header="Trạng thái" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="{Binding StatusBgColor}" CornerRadius="4" Padding="7,2.5" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding StatusName}" FontSize="12" FontWeight="SemiBold" Foreground="{Binding StatusFgColor}"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Hoàn thành" Binding="{Binding CompletedAtText}" Width="118"/>
                    
                    <DataGridTemplateColumn Header="Thao tác" Width="185">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="2,0,0,0">
                                    <!-- Nút Thao tác chính (Duyệt / Nhận việc / Báo cáo) -->
                                    <Button Content="{Binding PrimaryActionText}"
                                            Click="btnUpdateTask_Click" Tag="{Binding TaskId}" Margin="0,0,6,0">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource TaskActionPrimaryButtonStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ShowPrimaryAction}" Value="False">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>

                                    <!-- Nút Làm lại (chỉ hiển thị cho Quản lý khi task Chờ xác nhận) -->
                                    <Button Content="Làm lại"
                                            Click="btnRejectTask_Click" Tag="{Binding TaskId}" Margin="0,0,6,0">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource TaskActionRejectButtonStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ShowRejectAction}" Value="False">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>

                                    <!-- Nút Hủy nhiệm vụ (chỉ hiển thị cho Quản lý khi task chưa hoàn thành) -->
                                    <Button Content="Hủy"
                                            Click="btnDeleteTask_Click" Tag="{Binding TaskId}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource TaskActionDeleteButtonStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ShowDeleteAction}" Value="False">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Border>
</Page>
