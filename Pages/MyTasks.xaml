<Page x:Class="Hotel_Management.Pages.MyTasks"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
      d:DesignHeight="566" d:DesignWidth="920" Title="Nhiệm Vụ Của Tôi" FontFamily="Times New Roman">

    <Border CornerRadius="5" Background="{DynamicResource SecondaryBackgroundColor}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="70"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Label Grid.Row="0" x:Name="lblTitle" Content="Nhiệm Vụ Của Tôi" 
                Style="{DynamicResource LabelStyle}" 
                HorizontalAlignment="Left" VerticalAlignment="Center" 
                Margin="40 0 0 0" Padding="10 5 0 5"
                BorderBrush="{DynamicResource PrimaryBlueColor}" BorderThickness="4 0 0 0"/>    

            <Button Grid.Row="0" x:Name="btnRefresh" Content="Làm Mới" Width="120" Height="36"
                    HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,20,0"
                    Style="{DynamicResource SecondaryButtonStyle}" Click="btnRefresh_Click"/>

            <!-- Form Giao Việc Mới cho Quản lý (Ẩn đối với Nhân viên) -->
            <Border Grid.Row="1" x:Name="AdminAssignPanel" Background="{DynamicResource PrimaryBackgroundColor}" CornerRadius="5" BorderBrush="{DynamicResource PrimaryBlueColor}" BorderThickness="1" Padding="15,12" Margin="20,0,20,12" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="GIAO NHIỆM VỤ DỌN PHÒNG / CÔNG VIỆC MỚI" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource PrimaryBlueColor}" Margin="0,0,0,10"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,16,0" VerticalAlignment="Center">
                            <TextBlock Text="Phòng:" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryColor}" FontSize="14" Margin="0,0,8,0"/>
                            <ComboBox x:Name="cbTaskRoom" Width="125" Height="36" Style="{DynamicResource ComboBoxStyle}" DisplayMemberPath="RoomNumber" SelectedValuePath="RoomId"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,16,0" VerticalAlignment="Center">
                            <TextBlock Text="Giao cho:" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryColor}" FontSize="14" Margin="0,0,8,0"/>
                            <ComboBox x:Name="cbTaskStaff" Width="185" Height="36" Style="{DynamicResource ComboBoxStyle}" DisplayMemberPath="FullName" SelectedValuePath="Id"/>
                        </StackPanel>

                        <Grid Grid.Column="2" Margin="0,0,16,0" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Nhiệm vụ:" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryColor}" FontSize="14" Margin="0,0,8,0"/>
                            <TextBox Grid.Column="1" x:Name="txtTaskName" Width="Auto" Height="36" Style="{DynamicResource TextBoxStyle}" Tag="Nhập tên công việc cần giao..."/>
                        </Grid>

                        <Button Grid.Column="3" x:Name="btnCreateTask" Content="Giao Việc" Width="115" Height="36" Style="{DynamicResource PrimaryButtonStyle}" Click="btnCreateTask_Click"/>
                    </Grid>
                </StackPanel>
            </Border>
            
            <DataGrid Grid.Row="2" x:Name="dgTasks" Margin="20,0,20,20" Style="{DynamicResource DataGridStyle}" RowHeight="40">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Ngày Làm" Binding="{Binding WorkDate, StringFormat=dd/MM/yyyy}" Width="0.9*" MinWidth="82"/>
                    <DataGridTextColumn Header="Ca Trực" Binding="{Binding ShiftName}" Width="0.75*" MinWidth="68"/>
                    <DataGridTextColumn Header="Phòng" Binding="{Binding RoomNumber}" Width="0.6*" MinWidth="56"/>
                    <DataGridTextColumn Header="Tên Nhiệm Vụ" Binding="{Binding TaskName}" Width="2.1*" MinWidth="160"/>
                    <DataGridTextColumn Header="Người Phụ Trách" Binding="{Binding AssigneeName}" Width="1.2*" MinWidth="112"/>
                    <DataGridTextColumn Header="Trạng Thái" Binding="{Binding StatusName}" Width="1.05*" MinWidth="95"/>
                    <DataGridTextColumn Header="Hoàn Thành Lúc" Binding="{Binding CompletedAtText}" Width="1.2*" MinWidth="110"/>
                    
                    <DataGridTemplateColumn Header="Thao Tác" Width="210">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <!-- Nút Thao tác chính (Nhận việc / Báo cáo xong / Duyệt đạt) -->
                                    <Button Content="{Binding PrimaryActionText}" MinWidth="82" Height="28" FontSize="12.5" Margin="2,0" Padding="8,0"
                                            Click="btnUpdateTask_Click" Tag="{Binding TaskId}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ShowPrimaryAction}" Value="False">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>

                                    <!-- Nút Yêu cầu làm lại (chỉ hiển thị cho Quản lý khi task Chờ xác nhận) -->
                                    <Button Content="Yêu cầu làm lại" MinWidth="100" Height="28" FontSize="12.5" Margin="2,0" Padding="8,0"
                                            Click="btnRejectTask_Click" Tag="{Binding TaskId}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ShowRejectAction}" Value="False">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Border>
</Page>
