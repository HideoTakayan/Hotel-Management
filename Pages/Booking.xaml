<Page x:Class="Hotel_Management.Pages.Booking"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Hotel_Management.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="850" d:DesignWidth="920" Title="Đặt phòng" FontFamily="Segoe UI">

    <Page.Resources>
        <Style x:Key="RoomCardButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Border CornerRadius="5" Background="{DynamicResource SecondaryBackgroundColor}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="0,0,0,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="65"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Label Grid.Row="0" Content="Đặt phòng" 
                       Style="{DynamicResource LabelStyle}" 
                       HorizontalAlignment="Left" VerticalAlignment="Center" 
                       Margin="40 0 0 0" Padding="10 5 0 5"
                       BorderBrush="{DynamicResource PrimaryBlueColor}" BorderThickness="4 0 0 0"/>

                <!-- Form nhập thông tin đặt phòng chia 2 cột đồng bộ -->
                <Border Grid.Row="1" Margin="30,8,30,8" Padding="25,18" Background="{DynamicResource PrimaryBackgroundColor}" CornerRadius="6" BorderBrush="{DynamicResource SecondaryGrayColor}" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Cột trái: Thông tin khách hàng -->
                        <StackPanel Grid.Column="0" Margin="0,0,20,0">
                            <TextBlock Text="Thông tin khách hàng" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryColor}" Margin="0,0,0,12"/>

                            <StackPanel Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Họ và tên" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryColor}" FontSize="14"/>
                                    <TextBox Grid.Column="1" x:Name="txtHoVaTen" Width="Auto" Style="{DynamicResource TextBoxStyle}" Tag="Nhập họ và tên khách hàng"/>
                                </Grid>
                                <TextBlock x:Name="txtHoVaTenError" Text="Vui lòng nhập họ và tên" Margin="110,2,0,0" Foreground="{DynamicResource ErrorNotification}" FontSize="12" Visibility="Collapsed"/>
                            </StackPanel>

                            <StackPanel Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Số điện thoại" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryColor}" FontSize="14"/>
                                    <TextBox Grid.Column="1" x:Name="txtPhone" Width="Auto" Style="{DynamicResource TextBoxStyle}" Tag="Số điện thoại (9 - 12 số)"/>
                                </Grid>
                                <TextBlock x:Name="txtPhoneError" Text="Số điện thoại phải từ 9 đến 12 chữ số" Margin="110,2,0,0" Foreground="{DynamicResource ErrorNotification}" FontSize="12" Visibility="Collapsed"/>
                            </StackPanel>

                            <StackPanel Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Email" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryColor}" FontSize="14"/>
                                    <TextBox Grid.Column="1" x:Name="txtEmail" Width="Auto" Style="{DynamicResource TextBoxStyle}" Tag="Địa chỉ Email (không bắt buộc)"/>
                                </Grid>
                                <TextBlock x:Name="txtEmailError" Text="Vui lòng nhập đúng định dạng email" Margin="110,2,0,0" Foreground="{DynamicResource ErrorNotification}" FontSize="12" Visibility="Collapsed"/>
                            </StackPanel>

                            <StackPanel Margin="0,0,0,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Số người" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryColor}" FontSize="14"/>
                                    <TextBox Grid.Column="1" x:Name="txtSoNguoi" Width="Auto" Style="{DynamicResource TextBoxStyle}" Tag="Số lượng khách lưu trú"/>
                                </Grid>
                                <TextBlock x:Name="txtSoNguoiError" Text="Số người không hợp lệ" Margin="110,2,0,0" Foreground="{DynamicResource ErrorNotification}" FontSize="12" Visibility="Collapsed"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Cột phải: Thông tin phòng & Thời gian lưu trú -->
                        <StackPanel Grid.Column="1" Margin="20,0,0,0">
                            <TextBlock Text="Phòng và thời gian lưu trú" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryColor}" Margin="0,0,0,12"/>

                            <StackPanel Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Phòng" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryColor}" FontSize="14"/>
                                    <Button Grid.Column="1" x:Name="btnChonPhong" Content="Chọn phòng" Width="115" Style="{DynamicResource PrimaryButtonStyle}" Click="BtnChonPhong_Click"/>
                                    <Grid Grid.Column="2" Height="36" Margin="10,0,0,0">
                                        <Rectangle Fill="{DynamicResource SecondaryBackgroundColor}" Stroke="{DynamicResource SecondaryGrayColor}" StrokeThickness="1" RadiusX="5" RadiusY="5"/>
                                        <TextBlock x:Name="txtPhong" Text="Chưa chọn phòng" VerticalAlignment="Center" HorizontalAlignment="Left" Foreground="{DynamicResource TextSecondaryColor}" FontWeight="SemiBold" Margin="12,0,12,0" TextTrimming="CharacterEllipsis"/>
                                    </Grid>
                                </Grid>
                                <TextBlock x:Name="txtPhongError" Text="Vui lòng chọn phòng" Margin="110,2,0,0" Foreground="{DynamicResource ErrorNotification}" FontSize="12" Visibility="Collapsed"/>
                            </StackPanel>

                            <StackPanel Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Ngày nhận" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryColor}" FontSize="14"/>
                                    <DatePicker Grid.Column="1" x:Name="dateNgayNhan" Width="Auto" Style="{DynamicResource DatePickerStyle}" />
                                </Grid>
                                <TextBlock x:Name="dateNgayNhanError" Text="Vui lòng chọn ngày nhận" Margin="110,2,0,0" Foreground="{DynamicResource ErrorNotification}" FontSize="12" Visibility="Collapsed"/>
                            </StackPanel>

                            <StackPanel Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Ngày trả" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryColor}" FontSize="14"/>
                                    <DatePicker Grid.Column="1" x:Name="dateNgayTra" Width="Auto" Style="{DynamicResource DatePickerStyle}" />
                                </Grid>
                                <TextBlock x:Name="dateNgayTraError" Text="Vui lòng chọn ngày trả" Margin="110,2,0,0" Foreground="{DynamicResource ErrorNotification}" FontSize="12" Visibility="Collapsed"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Các nút tác vụ -->
                <StackPanel Orientation="Horizontal" Grid.Row="2" HorizontalAlignment="Center" Margin="0,8,0,12">
                    <Button x:Name="btnDatPhong" Content="Đặt phòng" VerticalAlignment="Center" Width="130" Margin="0,0,12,0" Style="{DynamicResource PrimaryButtonStyle}" Click="BtnDatPhong_Click"/>
                    <Button x:Name="btnRefresh" Content="Làm mới" VerticalAlignment="Center" Width="130" Margin="0,0,0,0" Style="{DynamicResource SecondaryButtonStyle}" Click="BtnRefresh_Click"/>
                </StackPanel>

                <!-- Bảng sơ đồ trạng thái phòng trực quan (10 phòng khách sạn) -->
                <Border Grid.Row="3" Margin="30,0,30,10" Padding="20,14" Background="{DynamicResource PrimaryBackgroundColor}" CornerRadius="6" BorderBrush="{DynamicResource SecondaryGrayColor}" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Banner Cảnh Báo Phòng Đến Hạn Trả Hôm Nay Cho Quản Trị Viên -->
                        <Border Grid.Row="0" x:Name="borderCheckoutNotice" Margin="0,0,0,12" Padding="14,10" Background="#26E74C3C" BorderBrush="#E74C3C" BorderThickness="1.5" CornerRadius="6" Visibility="Collapsed">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <iconPacks:PackIconBootstrapIcons Grid.Column="0" Kind="BellFill" Width="18" Height="18" Foreground="#E74C3C" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="txtCheckoutNoticeTitle" Text="Phòng đến hạn trả hôm nay" FontSize="13" FontWeight="SemiBold" Foreground="#E74C3C"/>
                                    <TextBlock x:Name="txtCheckoutNoticeDesc" Text="Các phòng cần kiểm tra trả phòng..." FontSize="12" Foreground="{DynamicResource TextSecondaryColor}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                </StackPanel>
                                <Button Grid.Column="2" x:Name="btnViewDueCheckouts" Content="Xử lý trả phòng" Style="{DynamicResource PrimaryButtonStyle}" Height="30" Padding="12,0" FontSize="12" VerticalAlignment="Center" Click="BtnViewDueCheckouts_Click"/>
                            </Grid>
                        </Border>

                        <!-- Tiêu đề + Chú thích trạng thái -->
                        <Grid Grid.Row="1" Margin="0,0,0,12">
                            <TextBlock Text="Sơ đồ phòng" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryColor}" VerticalAlignment="Center" HorizontalAlignment="Left"/>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Border Background="#1A2ECC71" BorderBrush="#2ECC71" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="8" Height="8" Fill="#2ECC71" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <TextBlock Text="Trống (Sẵn sàng)" FontSize="11" Foreground="#2ECC71" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="#1A3498DB" BorderBrush="#3498DB" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="8" Height="8" Fill="#3498DB" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <TextBlock Text="Đang sử dụng" FontSize="11" Foreground="#3498DB" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="#1AF39C12" BorderBrush="#F39C12" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="8" Height="8" Fill="#F39C12" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <TextBlock Text="Đã đặt trước" FontSize="11" Foreground="#F39C12" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="#1AE74C3C" BorderBrush="#E74C3C" BorderThickness="1" CornerRadius="4" Padding="6,2">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="8" Height="8" Fill="#E74C3C" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <TextBlock Text="Chờ dọn dẹp" FontSize="11" Foreground="#E74C3C" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <!-- Danh sách 10 phòng -->
                        <ItemsControl Grid.Row="2" x:Name="icRoomStatus">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource RoomCardButtonStyle}" Click="RoomCard_Click" Margin="5,6" Tag="{Binding}">
                                        <Border Width="164" Height="100" CornerRadius="6" Background="{Binding StatusBg}" BorderBrush="{Binding StatusColor}" BorderThickness="1.5" Padding="10,8">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="*"/>
                                                </Grid.RowDefinitions>

                                                <!-- Dòng 1: Số phòng + Huy hiệu trạng thái & Cảnh báo trả phòng -->
                                                <Grid Grid.Row="0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding RoomNumber, StringFormat='Phòng {0}'}" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryColor}" VerticalAlignment="Center"/>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                        <Border Background="#E74C3C" CornerRadius="3" Padding="3.5,1" Margin="0,0,3,0" Visibility="{Binding DueWarningVisibility}" ToolTip="Đến hạn trả phòng hôm nay!">
                                                            <TextBlock Text="Hạn trả" FontSize="9" FontWeight="Bold" Foreground="White"/>
                                                        </Border>
                                                        <Border Background="{Binding StatusColor}" CornerRadius="3" Padding="5,1.5">
                                                            <TextBlock Text="{Binding StatusText}" FontSize="9.5" FontWeight="Bold" Foreground="White"/>
                                                        </Border>
                                                    </StackPanel>
                                                </Grid>

                                                <!-- Dòng 2: Loại phòng & Giá -->
                                                <StackPanel Grid.Row="1" Margin="0,4,0,0">
                                                    <TextBlock Text="{Binding RoomType}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryColor}" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Price, StringFormat='{}{0:N0} đ/đêm'}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryBlueColor}"/>
                                                </StackPanel>

                                                <!-- Dòng 3: Thông tin khách hoặc số người tối đa -->
                                                <TextBlock Grid.Row="2" Text="{Binding DisplaySubtitle}" VerticalAlignment="Bottom" FontSize="11" Foreground="{DynamicResource TextSecondaryColor}" TextTrimming="CharacterEllipsis" FontStyle="Italic"/>
                                            </Grid>
                                        </Border>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>
            </Grid>
        </ScrollViewer>
    </Border>
</Page>
