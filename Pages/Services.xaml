<Page x:Class="Hotel_Management.Pages.Services"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Hotel_Management.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="566" d:DesignWidth="920" Title="Quản Lý Dịch Vụ" FontFamily="Segoe UI">
    <Border CornerRadius="5" Background="{DynamicResource SecondaryBackgroundColor}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="65"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Label Grid.Row="0" Content="Quản lý dịch vụ" 
                           Style="{DynamicResource LabelStyle}" 
                           HorizontalAlignment="Left" VerticalAlignment="Center" 
                           Margin="40 0 0 0" Padding="10 5 0 5"
                           BorderBrush="{DynamicResource PrimaryBlueColor}" BorderThickness="4 0 0 0"/>
            
            <Grid Grid.Row="1" Margin="20,2,20,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- CỘT 1: GỌI DỊCH VỤ -->
                <Border Grid.Column="0" Background="{DynamicResource PrimaryBackgroundColor}" CornerRadius="6" BorderBrush="{DynamicResource SecondaryGrayColor}" BorderThickness="1" Padding="18,14" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="Gọi dịch vụ cho phòng" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryColor}" Margin="0,0,0,10"/>
                        
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="90"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Phòng" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryColor}" FontSize="14"/>
                            <ComboBox Grid.Column="1" x:Name="cbRooms" Width="Auto" Style="{DynamicResource ComboBoxStyle}" DisplayMemberPath="RoomNumber" SelectedValuePath="BillId" Tag="Chọn phòng đang ở"/>
                            <TextBlock Grid.Column="2" Text="Số lượng" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryColor}" FontSize="14" Margin="14,0,8,0"/>
                            <TextBox Grid.Column="3" x:Name="txtQuantity" Width="Auto" Text="1" Style="{DynamicResource TextBoxStyle}" Tag="SL"/>
                        </Grid>
                        <!-- Cảnh báo khi chưa có phòng Check-in -->
                        <TextBlock x:Name="txtNoRoomsNotice" 
                                   Text="Lưu ý: Hiện chưa có phòng nào đang lưu trú (Check-in). Vào mục 'Hóa đơn' chuyển khách sang Check-in để gọi dịch vụ." 
                                   TextWrapping="Wrap" Foreground="{DynamicResource WarningNotification}" FontSize="12" Margin="110,-2,0,8" Visibility="Collapsed"/>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Dịch vụ" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryColor}" FontSize="14"/>
                            <ComboBox Grid.Column="1" x:Name="cbServices" Width="Auto" Style="{DynamicResource ComboBoxStyle}" DisplayMemberPath="ServiceName" SelectedValuePath="ServiceId" Tag="Chọn dịch vụ" SelectionChanged="cbServices_SelectionChanged"/>
                        </Grid>

                        <!-- Dòng chọn nhân viên phục vụ / giao đồ (Tự động ẩn/hiện theo tính chất dịch vụ) -->
                        <Grid x:Name="gridStaffSelect" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Nhân viên giao" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryColor}" FontSize="14"/>
                            <ComboBox Grid.Column="1" x:Name="cbStaff" Width="Auto" Style="{DynamicResource ComboBoxStyle}" DisplayMemberPath="FullName" SelectedValuePath="Id" Tag="Chọn nhân viên phục vụ"/>
                        </Grid>
                        
                        <!-- Gợi ý tính chất dịch vụ: Trải nghiệm & Giải trí vs Phục vụ tại phòng -->
                        <TextBlock x:Name="txtServiceStaffHint" 
                                   Text="Dịch vụ tại chỗ: Tự động ghi vào hóa đơn, không tạo nhiệm vụ giao hàng." 
                                   TextWrapping="Wrap" Foreground="{DynamicResource PrimaryBlueColor}" FontSize="12" Margin="110,-4,0,8" Visibility="Collapsed"/>

                        <Button x:Name="btnOrderService" Content="Xác nhận và giao việc" Width="190" Height="36" Margin="110,0,0,0" HorizontalAlignment="Left" Style="{DynamicResource PrimaryButtonStyle}" Click="btnOrderService_Click"/>
                    </StackPanel>
                </Border>

                <!-- CỘT 2: QUẢN LÝ DANH MỤC DỊCH VỤ -->
                <Border Grid.Column="1" Background="{DynamicResource PrimaryBackgroundColor}" CornerRadius="6" BorderBrush="{DynamicResource SecondaryGrayColor}" BorderThickness="1" Padding="18,14" Margin="10,0,0,0">
                    <StackPanel>
                        <TextBlock Text="Danh mục dịch vụ" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryColor}" Margin="0,0,0,10"/>
                        
                        <StackPanel Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Tên dịch vụ" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryColor}" FontSize="14"/>
                                <TextBox Grid.Column="1" x:Name="txtServiceName" Width="Auto" Style="{DynamicResource TextBoxStyle}" Tag="Tên dịch vụ"/>
                            </Grid>
                            <TextBlock x:Name="txtServiceNameError" Text="Tên dịch vụ không được để trống" Margin="110,2,0,0" Foreground="{DynamicResource ErrorNotification}" FontSize="12" Visibility="Collapsed"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Đơn giá (VND)" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryColor}" FontSize="14"/>
                                <TextBox Grid.Column="1" x:Name="txtPrice" Width="Auto" Style="{DynamicResource TextBoxStyle}" Tag="Đơn giá"/>
                            </Grid>
                            <TextBlock x:Name="txtPriceError" Text="Đơn giá không hợp lệ" Margin="110,2,0,0" Foreground="{DynamicResource ErrorNotification}" FontSize="12" Visibility="Collapsed"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Đơn vị tính" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryColor}" FontSize="14"/>
                                <TextBox Grid.Column="1" x:Name="txtUnit" Width="Auto" Style="{DynamicResource TextBoxStyle}" Tag="Đơn vị (vd: Lượt, Suất, Bộ)"/>
                            </Grid>
                            <TextBlock x:Name="txtUnitError" Text="Đơn vị tính không được để trống" Margin="110,2,0,0" Foreground="{DynamicResource ErrorNotification}" FontSize="12" Visibility="Collapsed"/>
                        </StackPanel>

                        <UniformGrid Rows="1" HorizontalAlignment="Stretch" MaxWidth="420">
                            <Button x:Name="btnAdd" Content="Thêm dịch vụ" Margin="0,0,4,0" Padding="4,5" Style="{DynamicResource PrimaryButtonStyle}" Click="BtnAdd_Click"/>
                            <Button x:Name="btnUpdate" Content="Cập nhật" Margin="4,0,4,0" Padding="4,5" Style="{DynamicResource PrimaryButtonStyle}" Click="BtnUpdate_Click"/>
                            <Button x:Name="btnDel" Content="Xóa" Margin="4,0,4,0" Padding="4,5" Style="{DynamicResource SecondaryButtonStyle}" Click="BtnDel_Click"/>
                            <Button x:Name="btnRefresh" Content="Làm mới" Margin="4,0,0,0" Padding="4,5" Style="{DynamicResource SecondaryButtonStyle}" Click="BtnRefresh_Click" />
                        </UniformGrid>
                    </StackPanel>
                </Border>
            </Grid>

            <DataGrid Grid.Row="2" x:Name="ServicesDataGrid" Margin="20,0,20,16" SelectionChanged="ServicesDataGrid_SelectionChanged" Style="{DynamicResource DataGridStyle}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding ServiceId}" Width="0.45*" MinWidth="45" />
                    <DataGridTextColumn Header="Tên dịch vụ" Binding="{Binding ServiceName}" Width="2.8*" MinWidth="220" />
                    <DataGridTextColumn Header="Đơn giá (VND)" Binding="{Binding Price, StringFormat=N0}" Width="1.1*" MinWidth="110" />
                    <DataGridTextColumn Header="Đơn vị tính" Binding="{Binding Unit}" Width="0.8*" MinWidth="85"/>
                    <DataGridTextColumn Header="Phân loại" Binding="{Binding ServiceTypeDisplay}" Width="1.2*" MinWidth="125"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Border>
</Page>
