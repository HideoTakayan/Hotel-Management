<Page x:Class="Hotel_Management.Pages.Home"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Hotel_Management.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="650" d:DesignWidth="920"
      Title="Giới thiệu - Kinkaku-ji Onsen" FontFamily="Segoe UI">

    <Border CornerRadius="5" Background="{DynamicResource SecondaryBackgroundColor}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="0,0,0,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" Grid.Row="0" VerticalAlignment="Center" Margin="40,12,0,12">
                    <Label Content="Giới thiệu về" 
                           Style="{DynamicResource LabelStyle}" 
                           HorizontalAlignment="Left" VerticalAlignment="Center" 
                           Padding="10 5 0 5"
                           BorderBrush="{DynamicResource PrimaryBlueColor}" BorderThickness="4 0 0 0"/>
                    <Label Content="Kinkaku-ji Onsen &amp; Ryokan"
                           Style="{DynamicResource LabelStyle}"
                           HorizontalAlignment="Left" VerticalAlignment="Center"
                           Margin="6 0 0 0" Padding="0 5 0 5"    
                           Foreground="{DynamicResource PrimaryBlueColor}"/>
                </StackPanel>
                
                <Border Grid.Row="1" Margin="40,0,40,14" Height="190" CornerRadius="6" ClipToBounds="True">
                    <Grid>
                        <Image Source="/Assets/1.jpg" Stretch="UniformToFill"/>
                        <Border Background="#77000000"/>
                        
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="金 閣 寺 温 泉" FontSize="32" Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,4" FontFamily="Meiryo, Segoe UI">
                                <TextBlock.Effect>
                                    <DropShadowEffect BlurRadius="10" ShadowDepth="2" Color="Black" Opacity="0.5"/>
                                </TextBlock.Effect>
                            </TextBlock>
                            <TextBlock Text="K I N K A K U - J I   O N S E N   &amp;   R Y O K A N" FontSize="18" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center">
                                <TextBlock.Effect>
                                    <DropShadowEffect BlurRadius="8" ShadowDepth="1" Color="Black" Opacity="0.5"/>
                                </TextBlock.Effect>
                            </TextBlock>
                            <TextBlock Text="Không gian nghỉ dưỡng suối nước nóng &amp; lữ quán truyền thống Nhật Bản" FontSize="13" FontStyle="Italic" Foreground="#E0E0E0" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Row="2" Margin="40,0,40,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="6*"/>
                        <ColumnDefinition Width="4*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,28,0">
                        <TextBlock Text="Trải nghiệm nghỉ dưỡng suối khoáng nóng" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource PrimaryBlueColor}" Margin="0,0,0,6"/>
                        <Rectangle Fill="{DynamicResource PrimaryBlueColor}" Height="2" Width="50" HorizontalAlignment="Left" Margin="0,0,0,8" Opacity="0.7"/>
                        
                        <TextBlock TextWrapping="Wrap" FontSize="13.5" Foreground="{DynamicResource TextSecondaryColor}" LineHeight="22" TextAlignment="Justify" Margin="0,0,0,8"
                                   Text="Kinkaku-ji Onsen &amp; Ryokan được xây dựng theo phong cách lữ quán truyền thống Nhật Bản, mang đến không gian nghỉ dưỡng suối nước nóng yên bình và thư thái. Nguồn khoáng nóng tự nhiên duy trì ở nhiệt độ ấm áp quanh năm, kết hợp giữa bể ngâm khoáng ngoài trời và các bồn gỗ riêng biệt, giúp giải tỏa mệt mỏi và chăm sóc sức khỏe."/>
                        <TextBlock TextWrapping="Wrap" FontSize="13.5" Foreground="{DynamicResource TextSecondaryColor}" LineHeight="22" TextAlignment="Justify"
                                   Text="Hệ thống phòng nghỉ được bài trí theo kiến trúc Washitsu với sàn chiếu Tatami, nệm Futon cao cấp và cửa trượt Shoji thoáng đãng. Cùng với ẩm thực truyền thống, quầy thưởng trà và các tiện ích giải trí thư giãn, khách sạn hướng tới dịch vụ chuyên nghiệp, chu đáo và thân thiện cho mọi kỳ lưu trú."/>
                    </StackPanel>

                    <Border Grid.Column="1" CornerRadius="6" ClipToBounds="True" BorderBrush="{DynamicResource SecondaryGrayColor}" BorderThickness="1" Height="215">
                        <Image Source="/Assets/2.jpg" Stretch="UniformToFill"/>
                    </Border>
                </Grid>

                <Grid Grid.Row="3" Margin="40,0,40,0" VerticalAlignment="Bottom">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Margin="0,0,6,0" Padding="12,10" Background="{DynamicResource PrimaryBackgroundColor}" CornerRadius="6" BorderBrush="{DynamicResource SecondaryGrayColor}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Khu Suối Khoáng Nóng" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource PrimaryBlueColor}" Margin="0,0,0,4"/>
                            <TextBlock Text="Bao gồm bể tắm khoáng ngoài trời, bồn ngâm gỗ Hinoki riêng tư, phòng xông hơi đá muối và ngâm thảo dược dưỡng sinh." FontSize="11.5" Foreground="{DynamicResource TextSecondaryColor}" TextWrapping="Wrap" LineHeight="16"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Margin="3,0,3,0" Padding="12,10" Background="{DynamicResource PrimaryBackgroundColor}" CornerRadius="6" BorderBrush="{DynamicResource SecondaryGrayColor}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Hệ Thống Phòng Nghỉ" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource PrimaryBlueColor}" Margin="0,0,0,4"/>
                            <TextBlock Text="10 phòng nghỉ 2 tầng với các hạng phòng đơn, phòng đôi và phòng gia đình; trang bị đầy đủ chiếu Tatami và nệm Futon cao cấp." FontSize="11.5" Foreground="{DynamicResource TextSecondaryColor}" TextWrapping="Wrap" LineHeight="16"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Margin="3,0,3,0" Padding="12,10" Background="{DynamicResource PrimaryBackgroundColor}" CornerRadius="6" BorderBrush="{DynamicResource SecondaryGrayColor}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Ẩm Thực &amp; Thưởng Trà" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource PrimaryBlueColor}" Margin="0,0,0,4"/>
                            <TextBlock Text="Phục vụ các set ẩm thực Nhật Bản, buffet sáng, trứng luộc khoáng nóng, trà đạo Matcha cùng các loại đồ uống giải khát." FontSize="11.5" Foreground="{DynamicResource TextSecondaryColor}" TextWrapping="Wrap" LineHeight="16"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="3" Margin="6,0,0,0" Padding="12,10" Background="{DynamicResource PrimaryBackgroundColor}" CornerRadius="6" BorderBrush="{DynamicResource SecondaryGrayColor}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Dịch Vụ &amp; Giải Trí" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource PrimaryBlueColor}" Margin="0,0,0,4"/>
                            <TextBlock Text="Cung cấp trang phục Kimono/Yukata dạo khuôn viên, phòng Bida, bóng bàn, cờ tướng và các trò chơi thư giãn cho khách." FontSize="11.5" Foreground="{DynamicResource TextSecondaryColor}" TextWrapping="Wrap" LineHeight="16"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </ScrollViewer>
    </Border>
</Page>