<Page x:Class="Hotel_Management.Pages.Bills"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Hotel_Management.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="566" d:DesignWidth="920" Title="Quản Lý Hóa Đơn" FontFamily="Segoe UI">

    <Border CornerRadius="5" Background="{DynamicResource SecondaryBackgroundColor}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="65"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Label Grid.Row="0" Content="Quản lý hóa đơn" 
                   Style="{DynamicResource LabelStyle}" 
                   HorizontalAlignment="Left" VerticalAlignment="Center" 
                   Margin="40 0 0 0" Padding="10 5 0 5"
                   BorderBrush="{DynamicResource PrimaryBlueColor}" BorderThickness="4 0 0 0"/> 

            <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,20,0">
                <TextBox x:Name="txtSearchBill" Width="175" Height="36" Style="{DynamicResource TextBoxStyle}" Tag="Tìm tên / SĐT / Phòng..." TextChanged="txtSearchBill_TextChanged"/>
                <TextBlock Text="Lọc trạng thái:" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryColor}" FontSize="14" FontWeight="SemiBold" Margin="12,0,6,0"/>
                <ComboBox x:Name="cbFilterStatus" Width="165" Height="36" Style="{DynamicResource ComboBoxStyle}" Tag="Lọc trạng thái" SelectionChanged="cbFilterStatus_SelectionChanged">
                    <ComboBoxItem Content="Tất cả trạng thái" IsSelected="True"/>
                    <ComboBoxItem Content="Chưa thanh toán" Tag="0"/>
                    <ComboBoxItem Content="Đã thanh toán" Tag="1"/>
                    <ComboBoxItem Content="Đã hủy" Tag="2"/>
                    <ComboBoxItem Content="Check-in" Tag="3"/>
                    <ComboBoxItem Content="Chờ thanh toán" Tag="4"/>
                </ComboBox>
            </StackPanel> 

            <Border Grid.Row="1" Margin="20,0,20,10" Padding="18,14" Background="{DynamicResource PrimaryBackgroundColor}" CornerRadius="6" BorderBrush="{DynamicResource SecondaryGrayColor}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="320"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" Margin="0,0,24,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Thông tin hóa đơn đang chọn" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryBlueColor}" Margin="0,0,0,12"/>

                        <Grid Grid.Row="1" VerticalAlignment="Center">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="1.2*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Khách hàng:" Foreground="{DynamicResource PrimaryGrayColor}" FontSize="13" Margin="0,0,10,10" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="txtKhachHang" Text="---" Foreground="{DynamicResource TextPrimaryColor}" FontSize="13.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,0,20,10" VerticalAlignment="Center"/>

                            <TextBlock Grid.Row="0" Grid.Column="2" Text="Phòng số:" Foreground="{DynamicResource PrimaryGrayColor}" FontSize="13" Margin="0,0,10,10" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="0" Grid.Column="3" x:Name="txtPhong" Text="---" Foreground="{DynamicResource TextPrimaryColor}" FontSize="13.5" FontWeight="SemiBold" Margin="0,0,0,10" VerticalAlignment="Center"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Số điện thoại:" Foreground="{DynamicResource PrimaryGrayColor}" FontSize="13" Margin="0,0,10,10" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="txtPhone" Text="---" Foreground="{DynamicResource TextPrimaryColor}" FontSize="13.5" FontWeight="SemiBold" Margin="0,0,20,10" VerticalAlignment="Center"/>

                            <TextBlock Grid.Row="1" Grid.Column="2" Text="Số khách:" Foreground="{DynamicResource PrimaryGrayColor}" FontSize="13" Margin="0,0,10,10" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="1" Grid.Column="3" x:Name="txtSoNguoi" Text="---" Foreground="{DynamicResource TextPrimaryColor}" FontSize="13.5" FontWeight="SemiBold" Margin="0,0,0,10" VerticalAlignment="Center"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Thời gian:" Foreground="{DynamicResource PrimaryGrayColor}" FontSize="13" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" x:Name="txtThoiGianLuuTru" Text="---" Foreground="{DynamicResource TextPrimaryColor}" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </Grid>
                    </Grid>

                    <Rectangle Grid.Column="1" Width="1" Fill="{DynamicResource SecondaryGrayColor}" Margin="0,2,24,2"/>

                    <Border Grid.Column="2" Padding="16,12" Background="{DynamicResource SecondaryBackgroundColor}" CornerRadius="6" BorderBrush="{DynamicResource SecondaryGrayColor}" BorderThickness="1">
                        <StackPanel VerticalAlignment="Center">
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="Tiền phòng:" FontSize="13" Foreground="{DynamicResource PrimaryGrayColor}"/>
                                <TextBlock x:Name="txtTienPhongDetail" Text="0 VND" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryColor}" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="Tiền dịch vụ:" FontSize="13" Foreground="{DynamicResource PrimaryGrayColor}"/>
                                <TextBlock x:Name="txtTienDichVuDetail" Text="0 VND" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryColor}" HorizontalAlignment="Right"/>
                            </Grid>
                            <Rectangle Height="1" Fill="{DynamicResource SecondaryGrayColor}" Margin="0,4,0,8"/>
                            <Grid>
                                <TextBlock Text="Tổng cộng:" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryColor}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="txtTongTien" Text="0 VND" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource ErrorNotification}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Grid Grid.Row="2" Margin="20,2,20,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Cập nhật trạng thái:" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryColor}" FontSize="13.5" FontWeight="SemiBold" Margin="0,0,10,0"/>
                <ComboBox Grid.Column="1" x:Name="comboboxTrangThai" Width="220" Height="36" Style="{DynamicResource ComboBoxStyle}" Tag="Chọn trạng thái mới" IsEnabled="False">
                    <ComboBoxItem Tag="0">Chưa thanh toán</ComboBoxItem>
                    <ComboBoxItem Tag="1">Đã thanh toán</ComboBoxItem>
                    <ComboBoxItem Tag="2">Đã hủy</ComboBoxItem>
                    <ComboBoxItem Tag="3">Đã nhận phòng (Check-in)</ComboBoxItem>
                    <ComboBoxItem Tag="4">Trả phòng (Chờ thanh toán)</ComboBoxItem>
                </ComboBox>

                <TextBlock Grid.Column="2" x:Name="txtStatusLockedHint" Text="Hóa đơn đã hoàn tất, không thể chỉnh sửa." 
                           Foreground="{DynamicResource WarningNotification}" VerticalAlignment="Center" Margin="12,0,10,0" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Visibility="Collapsed"/>

                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="btnViewDetails" Content="Xem chi tiết" Width="115" Height="36" Margin="0,0,8,0" Style="{DynamicResource PrimaryButtonStyle}" Click="BtnViewDetails_Click"/>
                    <Button x:Name="btnUpdateBill" Content="Cập nhật" Width="100" Height="36" Margin="0,0,8,0" Style="{DynamicResource PrimaryButtonStyle}" Click="UpdateStatusButton_Click" IsEnabled="False"/>
                    <Button x:Name="btnDelBill" Content="Xóa" Width="80" Height="36" Margin="0,0,8,0" Style="{DynamicResource SecondaryButtonStyle}" Click="BtnDelBill_Click"/>
                    <Button x:Name="btnRefresh" Content="Làm mới" Width="95" Height="36" Style="{DynamicResource SecondaryButtonStyle}" Click="BtnRefresh_Click"/>
                </StackPanel>
            </Grid>

            <DataGrid Grid.Row="3" x:Name="BillsDataGrid" Margin="20,0,20,16" SelectionChanged="BillsDataGrid_SelectionChanged" Style="{DynamicResource DataGridStyle}" HorizontalScrollBarVisibility="Disabled">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding BillId}" Width="45"/>
                    <DataGridTextColumn Header="Ngày tạo" Binding="{Binding CreatedAt, StringFormat=dd/MM/yyyy HH:mm}" Width="125"/>
                    <DataGridTextColumn Header="Họ và tên" Binding="{Binding FullName}" Width="*" MinWidth="140"/>
                    <DataGridTextColumn Header="Số điện thoại" Binding="{Binding Phone}" Width="105"/>
                    <DataGridTextColumn Header="Phòng" Binding="{Binding Room.RoomNumber}" Width="65"/>
                    <DataGridTextColumn Header="Tổng tiền (VND)" Binding="{Binding Total, StringFormat={}{0:N0}}" Width="120">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Margin" Value="0,0,10,0"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Trạng thái" Binding="{Binding StatusName}" Width="125"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Border>
</Page>